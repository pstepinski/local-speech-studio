# auto selects CUDA, then Apple MPS, then CPU. Use cuda for RTX 50-series.
CHATTERBOX_DEVICE=auto

# On a two-GPU machine, keep Whisper separate from Chatterbox.
WHISPER_DEVICE=auto
WHISPER_MODEL_ID=openai/whisper-large-v3-turbo
WHISPER_MAX_UPLOAD_MB=100
WHISPER_WAKE_PHRASE=OK Studio!

# Optional upstream addresses used by the server-side GUI proxy.
# Local start defaults to localhost; Docker Compose defaults to tts/stt containers.
# GUI_TTS_UPSTREAM_URL=http://localhost:8000
# GUI_STT_UPSTREAM_URL=http://localhost:8001
GUI_ENABLE_TTS=true
GUI_ENABLE_STT=true
GUI_ENABLE_CONTINUOUS=true

# Optional local WAV file used for voice cloning
# CHATTERBOX_VOICE_PROMPT=/absolute/path/to/voice-sample.wav

